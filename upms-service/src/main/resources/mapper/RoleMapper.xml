<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.auth.center.role.infrastructure.repository.RoleMapper">
    
    <!-- 根据用户ID查询用户拥有的角色 -->
    <select id="selectByUserId" resultType="com.auth.center.role.domain.entity.RoleEntity">
        SELECT r.* 
        FROM sys_role r
        INNER JOIN sys_user_role ur ON r.id = ur.role_id
        WHERE r.tenant_id = #{tenantId} AND ur.user_id = #{userId} AND r.status = 1
    </select>
    
</mapper>